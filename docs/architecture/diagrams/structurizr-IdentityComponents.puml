@startuml
title <size:24>Component View: EXE Group Management System - Identity Service</size>\n<size:24>Level 3: Identity Service.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Component>

System_Boundary("EXEGroupManagementSystem_boundary", "EXE Group Management System", $tags="") {
  Container_Boundary("EXEGroupManagementSystem.IdentityService_boundary", "Identity Service", $tags="") {
    Component(EXEGroupManagementSystem.IdentityService.AccessTokenFactory, "AccessTokenFactory", $techn="Microsoft.IdentityModel.JsonWebTokens", $descr="Issues HS256 JWTs shared with every service (BuildingBlocks).", $tags="", $link="")
    Component(EXEGroupManagementSystem.IdentityService.IdentityDbContext, "IdentityDbContext", $techn="EF Core 10", $descr="Users, Roles, UserRoles, RefreshTokens.", $tags="", $link="")
    Component(EXEGroupManagementSystem.IdentityService.AuthController, "AuthController", $techn="ASP.NET Core MVC", $descr="[Planned] POST /api/v1/auth/login, /refresh-token; GET/PUT /api/v1/auth/me.", $tags="", $link="")
    Component(EXEGroupManagementSystem.IdentityService.UsersController, "UsersController", $techn="ASP.NET Core MVC", $descr="[Planned] Administrator user and role management.", $tags="", $link="")
  }

  ContainerDb(EXEGroupManagementSystem.IdentityDb, "IdentityDb", $techn="SQL Server 2022", $descr="Users, roles and refresh tokens.", $tags="", $link="")
  Container(EXEGroupManagementSystem.APIGateway, "API Gateway", $techn="ASP.NET Core 10, YARP 2.3", $descr="Single public entry point: JWT check at the edge, path routing, merged Swagger UI, sign-in rate limit.", $tags="", $link="")
}

Rel(EXEGroupManagementSystem.APIGateway, EXEGroupManagementSystem.IdentityService.AuthController, "Routes /api/v1/auth, /api/v1/users", $techn="HTTP", $tags="", $link="")
Rel(EXEGroupManagementSystem.IdentityService.AuthController, EXEGroupManagementSystem.IdentityService.AccessTokenFactory, "Issues tokens with", $techn="", $tags="", $link="")
Rel(EXEGroupManagementSystem.IdentityService.AuthController, EXEGroupManagementSystem.IdentityService.IdentityDbContext, "Reads users", $techn="", $tags="", $link="")
Rel(EXEGroupManagementSystem.IdentityService.UsersController, EXEGroupManagementSystem.IdentityService.IdentityDbContext, "Reads and writes users", $techn="", $tags="", $link="")
Rel(EXEGroupManagementSystem.IdentityService.IdentityDbContext, EXEGroupManagementSystem.IdentityDb, "Reads and writes", $techn="SQL", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml