@startuml
title <size:24>Container View: EXE Group Management System</size>\n<size:24>Level 2: deployable containers and how they talk.</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

Person(StudentTeamLeader, "Student / Team Leader", $descr="EXE student; may lead a group in a class.", $tags="", $link="")
Person(Lecturer, "Lecturer", $descr="Teaches EXE classes and monitors grouping.", $tags="", $link="")
Person(Administrator, "Administrator", $descr="Manages users, semesters, courses, classes and rosters.", $tags="", $link="")

System_Boundary("EXEGroupManagementSystem_boundary", "EXE Group Management System", $tags="") {
  Container(EXEGroupManagementSystem.GroupService, "Group Service", $techn="ASP.NET Core 10 Web API + gRPC server", $descr="Semesters, courses, classes, rosters, groups; gRPC GroupMembership; outbox.", $tags="", $link="")
  Container(EXEGroupManagementSystem.JoinRequestService, "Join Request Service", $techn="ASP.NET Core 10 Web API + gRPC client", $descr="Join-request lifecycle T1-T11; event consumer and reconciler.", $tags="", $link="")
  ContainerDb(EXEGroupManagementSystem.IdentityDb, "IdentityDb", $techn="SQL Server 2022", $descr="Users, roles and refresh tokens.", $tags="", $link="")
  ContainerDb(EXEGroupManagementSystem.GroupDb, "GroupDb", $techn="SQL Server 2022", $descr="Semesters, courses, classes, rosters, groups, memberships, outbox.", $tags="", $link="")
  ContainerDb(EXEGroupManagementSystem.RequestDb, "RequestDb", $techn="SQL Server 2022", $descr="Join requests and processed event ids.", $tags="", $link="")
  ContainerQueue(EXEGroupManagementSystem.GroupEvents, "Group Events", $techn="Redis 7 Stream", $descr="Stream group-events: GroupMemberAdded, GroupClosed.", $tags="", $link="")
  Container(EXEGroupManagementSystem.SinglePageApp, "Single-Page App", $techn="React 19, TypeScript, Vite, nginx", $descr="UI for all roles; nginx also proxies /api and /swagger to the gateway.", $tags="", $link="")
  Container(EXEGroupManagementSystem.APIGateway, "API Gateway", $techn="ASP.NET Core 10, YARP 2.3", $descr="Single public entry point: JWT check at the edge, path routing, merged Swagger UI, sign-in rate limit.", $tags="", $link="")
  Container(EXEGroupManagementSystem.IdentityService, "Identity Service", $techn="ASP.NET Core 10 Web API", $descr="Sign-in, JWT access and refresh tokens, users and roles.", $tags="", $link="")
}

Rel(StudentTeamLeader, EXEGroupManagementSystem.SinglePageApp, "Forms and joins groups, reviews join requests", $techn="HTTPS", $tags="", $link="")
Rel(Lecturer, EXEGroupManagementSystem.SinglePageApp, "Monitors grouping progress", $techn="HTTPS", $tags="", $link="")
Rel(Administrator, EXEGroupManagementSystem.SinglePageApp, "Manages users, classes and deadlines", $techn="HTTPS", $tags="", $link="")
Rel(EXEGroupManagementSystem.SinglePageApp, EXEGroupManagementSystem.APIGateway, "Makes API calls", $techn="JSON envelope over HTTPS, /api/v1", $tags="", $link="")
Rel(EXEGroupManagementSystem.APIGateway, EXEGroupManagementSystem.IdentityService, "Routes /api/v1/auth, /api/v1/users", $techn="HTTP", $tags="", $link="")
Rel(EXEGroupManagementSystem.APIGateway, EXEGroupManagementSystem.GroupService, "Routes /api/v1/semesters", $techn="HTTP", $tags="", $link="")
Rel(EXEGroupManagementSystem.APIGateway, EXEGroupManagementSystem.JoinRequestService, "Routes /api/v1/join-requests", $techn="HTTP", $tags="", $link="")
Rel(EXEGroupManagementSystem.IdentityService, EXEGroupManagementSystem.IdentityDb, "Reads and writes", $techn="SQL", $tags="", $link="")
Rel(EXEGroupManagementSystem.GroupService, EXEGroupManagementSystem.GroupEvents, "Publishes", $techn="XADD", $tags="", $link="")
Rel(EXEGroupManagementSystem.GroupService, EXEGroupManagementSystem.GroupDb, "Reads and writes", $techn="SQL", $tags="", $link="")
Rel(EXEGroupManagementSystem.JoinRequestService, EXEGroupManagementSystem.GroupService, "GetGroupContext, AddMemberIfEligible", $techn="gRPC, HTTP/2 :8081", $tags="", $link="")
Rel(EXEGroupManagementSystem.JoinRequestService, EXEGroupManagementSystem.GroupEvents, "Consumes", $techn="XREADGROUP / XACK", $tags="", $link="")
Rel(EXEGroupManagementSystem.JoinRequestService, EXEGroupManagementSystem.RequestDb, "Reads and writes", $techn="SQL", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml