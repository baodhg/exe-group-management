@startuml
title <size:24>Deployment View: EXE Group Management System - Docker Compose</size>\n<size:24>Docker Compose deployment (7 containers).</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Deployment>

Deployment_Node(DockerCompose.Developermachine, "Developer machine", $type="Docker Desktop", $descr="", $tags="", $link="") {
  Deployment_Node(DockerCompose.Developermachine.web, "web", $type="nginx:1.27-alpine", $descr="Published 3000 -> 80", $tags="", $link="") {
    Container(DockerCompose.Developermachine.web.SinglePageApp_1, "Single-Page App", $techn="React 19, TypeScript, Vite, nginx", $descr="UI for all roles; nginx also proxies /api and /swagger to the gateway.", $tags="", $link="")
  }

  Deployment_Node(DockerCompose.Developermachine.gateway, "gateway", $type="mcr.microsoft.com/dotnet/aspnet:10.0", $descr="Published 8080", $tags="", $link="") {
    Container(DockerCompose.Developermachine.gateway.APIGateway_1, "API Gateway", $techn="ASP.NET Core 10, YARP 2.3", $descr="Single public entry point: JWT check at the edge, path routing, merged Swagger UI, sign-in rate limit.", $tags="", $link="")
  }

  Deployment_Node(DockerCompose.Developermachine.identityservice, "identity-service", $type="mcr.microsoft.com/dotnet/aspnet:10.0", $descr="Internal 8080", $tags="", $link="") {
    Container(DockerCompose.Developermachine.identityservice.IdentityService_1, "Identity Service", $techn="ASP.NET Core 10 Web API", $descr="Sign-in, JWT access and refresh tokens, users and roles.", $tags="", $link="")
  }

  Deployment_Node(DockerCompose.Developermachine.groupservice, "group-service", $type="mcr.microsoft.com/dotnet/aspnet:10.0", $descr="Internal 8080 (REST) and 8081 (gRPC, HTTP/2 only)", $tags="", $link="") {
    Container(DockerCompose.Developermachine.groupservice.GroupService_1, "Group Service", $techn="ASP.NET Core 10 Web API + gRPC server", $descr="Semesters, courses, classes, rosters, groups; gRPC GroupMembership; outbox.", $tags="", $link="")
  }

  Deployment_Node(DockerCompose.Developermachine.joinrequestservice, "join-request-service", $type="mcr.microsoft.com/dotnet/aspnet:10.0", $descr="Internal 8080", $tags="", $link="") {
    Container(DockerCompose.Developermachine.joinrequestservice.JoinRequestService_1, "Join Request Service", $techn="ASP.NET Core 10 Web API + gRPC client", $descr="Join-request lifecycle T1-T11; event consumer and reconciler.", $tags="", $link="")
  }

  Deployment_Node(DockerCompose.Developermachine.sqlserver, "sqlserver", $type="mcr.microsoft.com/mssql/server:2022-latest", $descr="Internal 1433 (host 14330 in development)", $tags="", $link="") {
    ContainerDb(DockerCompose.Developermachine.sqlserver.IdentityDb_1, "IdentityDb", $techn="SQL Server 2022", $descr="Users, roles and refresh tokens.", $tags="", $link="")
    ContainerDb(DockerCompose.Developermachine.sqlserver.GroupDb_1, "GroupDb", $techn="SQL Server 2022", $descr="Semesters, courses, classes, rosters, groups, memberships, outbox.", $tags="", $link="")
    ContainerDb(DockerCompose.Developermachine.sqlserver.RequestDb_1, "RequestDb", $techn="SQL Server 2022", $descr="Join requests and processed event ids.", $tags="", $link="")
  }

  Deployment_Node(DockerCompose.Developermachine.redis, "redis", $type="redis:7-alpine", $descr="Internal 6379, appendonly yes", $tags="", $link="") {
    ContainerQueue(DockerCompose.Developermachine.redis.GroupEvents_1, "Group Events", $techn="Redis 7 Stream", $descr="Stream group-events: GroupMemberAdded, GroupClosed.", $tags="", $link="")
  }

}

Rel(DockerCompose.Developermachine.web.SinglePageApp_1, DockerCompose.Developermachine.gateway.APIGateway_1, "Makes API calls", $techn="JSON envelope over HTTPS, /api/v1", $tags="", $link="")
Rel(DockerCompose.Developermachine.gateway.APIGateway_1, DockerCompose.Developermachine.identityservice.IdentityService_1, "Routes /api/v1/auth, /api/v1/users", $techn="HTTP", $tags="", $link="")
Rel(DockerCompose.Developermachine.gateway.APIGateway_1, DockerCompose.Developermachine.groupservice.GroupService_1, "Routes /api/v1/semesters", $techn="HTTP", $tags="", $link="")
Rel(DockerCompose.Developermachine.gateway.APIGateway_1, DockerCompose.Developermachine.joinrequestservice.JoinRequestService_1, "Routes /api/v1/join-requests", $techn="HTTP", $tags="", $link="")
Rel(DockerCompose.Developermachine.joinrequestservice.JoinRequestService_1, DockerCompose.Developermachine.groupservice.GroupService_1, "GetGroupContext, AddMemberIfEligible", $techn="gRPC, HTTP/2 :8081", $tags="", $link="")
Rel(DockerCompose.Developermachine.identityservice.IdentityService_1, DockerCompose.Developermachine.sqlserver.IdentityDb_1, "Reads and writes", $techn="SQL", $tags="", $link="")
Rel(DockerCompose.Developermachine.groupservice.GroupService_1, DockerCompose.Developermachine.sqlserver.GroupDb_1, "Reads and writes", $techn="SQL", $tags="", $link="")
Rel(DockerCompose.Developermachine.joinrequestservice.JoinRequestService_1, DockerCompose.Developermachine.sqlserver.RequestDb_1, "Reads and writes", $techn="SQL", $tags="", $link="")
Rel(DockerCompose.Developermachine.groupservice.GroupService_1, DockerCompose.Developermachine.redis.GroupEvents_1, "Publishes", $techn="XADD", $tags="", $link="")
Rel(DockerCompose.Developermachine.joinrequestservice.JoinRequestService_1, DockerCompose.Developermachine.redis.GroupEvents_1, "Consumes", $techn="XREADGROUP / XACK", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml