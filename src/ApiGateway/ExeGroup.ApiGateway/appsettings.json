{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "exe-group-system",
    "Audience": "exe-group-clients"
  },
  "Gateway": {
    "TrustedProxyHost": "",
    "AuthRateLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login": {
        "ClusterId": "identity",
        "Order": 1,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/v1/auth/login" }
      },
      "auth-refresh": {
        "ClusterId": "identity",
        "Order": 1,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/v1/auth/refresh-token" }
      },
      "auth-logout": {
        "ClusterId": "identity",
        "Order": 1,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/v1/auth/logout" }
      },
      "auth": {
        "ClusterId": "identity",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/auth/{**rest}" }
      },
      "users": {
        "ClusterId": "identity",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/users/{**rest}" }
      },
      "semesters": {
        "ClusterId": "group",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/semesters/{**rest}" }
      },
      "courses": {
        "ClusterId": "group",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/courses/{**rest}" }
      },
      "classes": {
        "ClusterId": "group",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/classes/{**rest}" }
      },
      "groups": {
        "ClusterId": "group",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/groups/{**rest}" }
      },
      "join-requests": {
        "ClusterId": "join-request",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/join-requests/{**rest}" }
      },
      "swagger-identity": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/swagger/identity/{**rest}" },
        "Transforms": [ { "PathPattern": "/swagger/{**rest}" } ]
      },
      "swagger-group": {
        "ClusterId": "group",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/swagger/group/{**rest}" },
        "Transforms": [ { "PathPattern": "/swagger/{**rest}" } ]
      },
      "swagger-join-request": {
        "ClusterId": "join-request",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/swagger/join-request/{**rest}" },
        "Transforms": [ { "PathPattern": "/swagger/{**rest}" } ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "primary": { "Address": "http://identity-service:8080" } }
      },
      "group": {
        "Destinations": { "primary": { "Address": "http://group-service:8080" } }
      },
      "join-request": {
        "Destinations": { "primary": { "Address": "http://join-request-service:8080" } }
      }
    }
  }
}
