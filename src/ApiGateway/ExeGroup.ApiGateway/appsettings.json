{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "exe-group-system",
    "Audience": "exe-group-clients"
  },
  "Gateway": {
    "TrustedProxyHost": "",
    "AuthRateLimit": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login": {
        "ClusterId": "identity",
        "Order": 1,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/v1/auth/login" }
      },
      "auth-refresh": {
        "ClusterId": "identity",
        "Order": 1,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/v1/auth/refresh-token" }
      },
      "auth-logout": {
        "ClusterId": "identity",
        "Order": 1,
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/v1/auth/logout" }
      },
      "auth": {
        "ClusterId": "identity",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/auth/{**rest}" }
      },
      "users": {
        "ClusterId": "identity",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/users/{**rest}" }
      },
      "semesters": {
        "ClusterId": "group",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/semesters/{**rest}" }
      },
      "subjects": {
        "ClusterId": "group",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/subjects/{**rest}" }
      },
      "majors": {
        "ClusterId": "group",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/majors/{**rest}" }
      },
      "skills": {
        "ClusterId": "group",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/skills/{**rest}" }
      },
      "group-types": {
        "ClusterId": "group",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/group-types/{**rest}" }
      },
      "courses": {
        "ClusterId": "group",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/courses/{**rest}" }
      },
      "rooms": {
        "ClusterId": "group",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/rooms/{**rest}" }
      },
      "join-requests": {
        "ClusterId": "group",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/join-requests/{**rest}" }
      },
      "conversations": {
        "ClusterId": "realtime",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/conversations/{**rest}" }
      },
      "messages": {
        "ClusterId": "realtime",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/messages/{**rest}" }
      },
      "notifications": {
        "ClusterId": "realtime",
        "Order": 10,
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/v1/notifications/{**rest}" }
      },
      "hubs": {
        "ClusterId": "realtime",
        "Order": 10,
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/hubs/{**rest}" }
      },
      "swagger-identity": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/swagger/identity/{**rest}" },
        "Transforms": [ { "PathPattern": "/swagger/{**rest}" } ]
      },
      "swagger-group": {
        "ClusterId": "group",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/swagger/group/{**rest}" },
        "Transforms": [ { "PathPattern": "/swagger/{**rest}" } ]
      },
      "swagger-realtime": {
        "ClusterId": "realtime",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/swagger/realtime/{**rest}" },
        "Transforms": [ { "PathPattern": "/swagger/{**rest}" } ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "primary": { "Address": "http://identity-service:8080" } }
      },
      "group": {
        "Destinations": { "primary": { "Address": "http://group-service:8080" } }
      },
      "realtime": {
        "Destinations": { "primary": { "Address": "http://realtime-service:8080" } }
      }
    }
  }
}
