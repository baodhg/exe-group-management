{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "RequestDb": ""
  },
  "Jwt": {
    "Issuer": "exe-group-system",
    "Audience": "exe-group-clients",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Redis": {
    "Connection": "redis:6379"
  },
  "GrpcClients": {
    "GroupService": "http://group-service:8081",
    "DeadlineSeconds": 5
  }
}
