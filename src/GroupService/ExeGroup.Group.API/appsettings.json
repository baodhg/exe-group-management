{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "GroupDb": ""
  },
  "Jwt": {
    "Issuer": "exe-group-system",
    "Audience": "exe-group-clients",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Redis": {
    "Connection": "redis:6379"
  },
  "Recommendation": {
    "Address": "http://recommendation-service:8081"
  },
  "Jobs": {
    "OutboxCleanup": {
      "RetentionDays": 7
    }
  }
}
