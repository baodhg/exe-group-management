{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",
  "GroupService": {
    "Address": "http://group-service:8080/"
  },
  "ConnectionStrings": {
    "ChatDb": ""
  },
  "Jwt": {
    "Issuer": "exe-group-system",
    "Audience": "exe-group-clients",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Redis": {
    "Connection": "redis:6379"
  },
  "Jobs": {
    "ProcessedEventsCleanup": {
      "RetentionDays": 7
    }
  }
}
